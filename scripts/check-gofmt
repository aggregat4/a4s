#!/usr/bin/env bash

set -euo pipefail

unformatted=$(find . -type f -name '*.go' \
  -not -path './.git/*' \
  -not -path './.cache/*' \
  -not -path './node_modules/*' \
  -print0 | xargs -0 -r gofmt -l)
if [[ -n "${unformatted}" ]]; then
  printf 'gofmt is required for:\n%s\n' "${unformatted}"
  exit 1
fi
