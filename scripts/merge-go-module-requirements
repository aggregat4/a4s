#!/usr/bin/env bash
# Merge an imported module's declared requirements into the root module without
# lowering a version already selected by an earlier import.
set -euo pipefail

source_mod=${1:?usage: scripts/merge-go-module-requirements SOURCE_GO_MOD}

while IFS=' ' read -r module_path module_version; do
	case "$module_path" in
		github.com/aggregat4/go-baselib|github.com/aggregat4/go-baselib-services/*)
			continue
			;;
	esac

	current_version=$(go list -m -f '{{.Version}}' "$module_path" 2>/dev/null || true)
	if [[ -z "$current_version" ]] || [[ "$(printf '%s\n%s\n' "$current_version" "$module_version" | sort -V | tail -n 1)" == "$module_version" ]]; then
		go mod edit -require="${module_path}@${module_version}"
	fi
done < <(go mod edit -json -modfile="$source_mod" | jq -r '.Require[] | "\(.Path) \(.Version)"')
