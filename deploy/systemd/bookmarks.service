[Unit]
Description=A4 Bookmarks
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=a4-bookmarks
Group=a4-bookmarks
WorkingDirectory=/opt/a4services/bookmarks
EnvironmentFile=/etc/a4s/bookmarks.env
ExecStart=/opt/a4services/bookmarks/current/bmserver
Restart=on-failure
RestartSec=2s
TimeoutStartSec=30s
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/a4services/bookmarks/db
UMask=0077

[Install]
WantedBy=multi-user.target
