# Installed as /etc/a4s/bookmarks.env with mode 0640 and group a4-bookmarks.
DELBM_DB_FILENAME=/opt/a4services/bookmarks/db/bookmarks.sqlite
DELBM_SERVER_PORT=1302
DELBM_BASE_URL=https://bookmarks.aggregat4.net
DELBM_OIDC_IDP_SERVER=https://openidprovider.aggregat4.net
DELBM_OIDC_CLIENT_ID=bookmarks
DELBM_OIDC_CLIENT_SECRET=replace-with-oidc-client-secret
DELBM_OIDC_REDIRECT_URI=https://bookmarks.aggregat4.net/oidccallback
DELBM_SESSION_COOKIE_SECRET_KEY=replace-with-openssl-rand-base64-32-output

# Optional tuning; these are the application defaults.
DELBM_MAX_CONTENT_DOWNLOAD_ATTEMPTS=3
DELBM_MAX_CONTENT_DOWNLOAD_TIMEOUT_SECONDS=20
DELBM_MAX_CONTENT_DOWNLOAD_SIZE_BYTES=2097152
DELBM_MAX_BOOKMARKS_TO_DOWNLOAD=20
DELBM_FEED_CRAWLING_INTERVAL_SECONDS=300
DELBM_MONTHS_TO_ADD_TO_FEED=6
DELBM_PAGE_SIZE=50
DELBM_SERVER_READ_TIMEOUT_SECONDS=5
DELBM_SERVER_WRITE_TIMEOUT_SECONDS=10
