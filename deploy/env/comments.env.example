# Installed as /etc/a4s/comments.env with mode 0640 and group a4-comments.
# Values here override deploy/config/comments/commentservice.json.example.
COMMENTSERVICE_OIDC_CLIENT_SECRET=replace-with-oidc-client-secret
COMMENTSERVICE_ENCRYPTION_KEY=replace-with-64-hex-character-key
COMMENTSERVICE_SESSION_COOKIE_SECRET_KEY=replace-with-openssl-rand-base64-32-output
