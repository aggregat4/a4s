# Installed as /etc/a4s/tasklists.env with mode 0640 and group a4-tasklists.
PORT=9085
SERVER_DB_PATH=/opt/a4services/tasklists/data/a4-tasklists.db
OIDC_ISSUER_URL=https://openidprovider.aggregat4.net
OIDC_CLIENT_ID=tasklists
OIDC_CLIENT_SECRET=replace-with-oidc-client-secret
OIDC_REDIRECT_URL=https://tasklists.aggregat4.net/auth/callback
SERVER_SESSION_KEY=replace-with-openssl-rand-base64-32-output
SERVER_COOKIE_SECURE=true
# Leave unset unless cookies must be shared across subdomains.
# SERVER_COOKIE_DOMAIN=tasklists.aggregat4.net
